{{!
    @template quiz_livequizmonitor/extension_actions

    Row action links added by other plugins (hook quiz_livequizmonitor\hook\extend_row_actions).
    Rendered inside row_action_menu on page load and by the browser when the actions change.

    Example context (json):
    {
        "hasextensionactions": true,
        "extensionactions": [
            {
                "label": "Show connection log",
                "url": "https://example.com/local/sebstatus/log.php?id=42",
                "iconkey": "i/info",
                "iconcomponent": "core",
                "newtab": true
            }
        ],
        "_extension_actions_lint_wrapper": true
    }
}}
{{#_extension_actions_lint_wrapper}}
<div role="menu">
{{/_extension_actions_lint_wrapper}}
{{#hasextensionactions}}
<div class="dropdown-divider livequizmonitor-extension-divider" role="presentation"></div>
{{#extensionactions}}
<a href="{{url}}"
   class="dropdown-item menu-action"
   role="menuitem"
   {{#newtab}}target="_blank"{{/newtab}}>
    {{#iconkey}}{{#pix}}{{iconkey}}, {{iconcomponent}}{{/pix}}{{/iconkey}}
    <span class="menu-action-text">{{label}}</span>
    {{#newtab}}
    <i class="fa-solid fa-up-right-from-square" aria-hidden="true"
        title="{{#str}}opensinnewwindow{{/str}}"></i>
    {{/newtab}}
</a>
{{/extensionactions}}
{{/hasextensionactions}}
{{#_extension_actions_lint_wrapper}}
</div>
{{/_extension_actions_lint_wrapper}}
