{{!
    @template quiz_livequizmonitor/extension_cell

    Cell of a column added by another plugin (hook quiz_livequizmonitor\hook\extend_columns).
    Rendered inside student_row on page load and by the browser when the value changes.
    The display value is cleaned on the server.

    Example context (json):
    {
        "column": "local_sebstatus-battery",
        "display": "85 %",
        "_extension_cell_lint_wrapper": true
    }
}}
{{#_extension_cell_lint_wrapper}}
<table class="visually-hidden" aria-hidden="true"><tbody><tr>
{{/_extension_cell_lint_wrapper}}
<td data-column="{{column}}" data-extension-cell="{{column}}">
    <div data-colcontent="{{column}}">{{{display}}}</div>
</td>
{{#_extension_cell_lint_wrapper}}
</tr></tbody></table>
{{/_extension_cell_lint_wrapper}}
