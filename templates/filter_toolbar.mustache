{{!
    @template quiz_livequizmonitor/filter_toolbar

    Filter toolbar for the live quiz monitor. Each filter (Name, Status, Group,
    Overrides) is an input group with its name as a leading label, and the
    filters wrap onto new lines as space allows. Status and Overrides are radio
    groups shown as buttons, each with a count badge.

    Only classes that exist in both Bootstrap 4 (Moodle 4.5) and Bootstrap 5
    (Moodle 5.x) are used; everything that differs between them, such as the
    hidden radio inputs and the corners inside an input group, is in styles.css.

    Example context (json):
    {
        "filter": {
            "filterslabel": "Filters",
            "labelsep": ": ",
            "resetalllabel": "Reset all filters",
            "namelabel": "Name",
            "groupmenu": "<div class='groupselector'><label for='groupmenu'>Separate groups</label> <select id='groupmenu'><option>All participants</option></select></div>",
            "searchplaceholder": "Search students",
            "statuslabel": "Status",
            "chips": [
                {"status": "all", "label": "All", "count": 4, "active": true},
                {"status": "notstarted", "label": "Not started", "count": 2, "active": false},
                {"status": "idle", "label": "Idle", "count": 1, "active": false},
                {"status": "inprogress", "label": "In progress", "count": 1, "active": true},
                {"status": "completed", "label": "Completed", "count": 0, "active": false}
            ],
            "canviewoverrides": true,
            "overridesgrouplabel": "Overrides",
            "nooverridelabel": "None",
            "nooverridecount": 1,
            "nooverrideactive": false,
            "alloverridelabel": "All",
            "alloverridecount": 3,
            "alloverrideactive": true,
            "useroverridelabel": "User",
            "useroverridecount": 1,
            "useroverrideactive": false,
            "groupoverridelabel": "Group",
            "groupoverridecount": 1,
            "groupoverrideactive": false
        }
    }
}}
<div class="livequizmonitor-filter-toolbar rounded mb-2 py-1 px-1" data-region="filter-toolbar">
    <div class="livequizmonitor-filter-toolbar-header">
        <span class="livequizmonitor-filter-toolbar-title">{{filter.filterslabel}}{{filter.labelsep}}</span>
    </div>
    <div class="livequizmonitor-filter-groups d-flex flex-wrap mx-1" role="toolbar" aria-label="{{filter.filterslabel}}">
        <div class="input-group livequizmonitor-filter-field livequizmonitor-filter-field-search" data-filter-group="name">
            <span class="input-group-text" id="livequizmonitor-filter-name-label-{{uniqid}}">{{filter.namelabel}}</span>
            <input type="search"
                   class="form-control livequizmonitor-search-input"
                   data-action="search"
                   placeholder="{{filter.searchplaceholder}}"
                   aria-labelledby="livequizmonitor-filter-name-label-{{uniqid}}">
        </div>
        <div class="input-group livequizmonitor-filter-field" data-filter-group="status"
             role="radiogroup" aria-labelledby="livequizmonitor-filter-status-label-{{uniqid}}">
            <span class="input-group-text" id="livequizmonitor-filter-status-label-{{uniqid}}">{{filter.statuslabel}}</span>
            {{#filter.chips}}
            <input type="radio"
                   class="btn-check"
                   name="livequizmonitor-filter-status-{{uniqid}}"
                   id="livequizmonitor-filter-status-{{status}}-{{uniqid}}"
                   value="{{status}}"
                   data-filter-option="status"
                   autocomplete="off"
                   {{#active}}checked{{/active}}>
            <label class="btn btn-outline-secondary livequizmonitor-filter-option"
                   for="livequizmonitor-filter-status-{{status}}-{{uniqid}}">
                <span data-option-label>{{label}}</span>
                <span class="badge livequizmonitor-count-badge{{^count}} livequizmonitor-count-badge-zero{{/count}}"
                      data-filter-count="{{status}}">{{count}}</span>
            </label>
            {{/filter.chips}}
        </div>
        {{#filter.groupmenu}}
        <div class="livequizmonitor-filter-field livequizmonitor-group-menu" data-filter-group="group" data-region="group-menu">
            {{{filter.groupmenu}}}
        </div>
        {{/filter.groupmenu}}
        {{#filter.canviewoverrides}}
        <div class="input-group livequizmonitor-filter-field" data-filter-group="overrides"
             role="radiogroup" aria-labelledby="livequizmonitor-filter-overrides-label-{{uniqid}}">
            <span class="input-group-text" id="livequizmonitor-filter-overrides-label-{{uniqid}}">{{filter.overridesgrouplabel}}</span>
            <input type="radio"
                   class="btn-check"
                   name="livequizmonitor-filter-overrides-{{uniqid}}"
                   id="livequizmonitor-filter-overrides-useroverride-{{uniqid}}"
                   value="useroverride"
                   data-filter-option="overrides"
                   autocomplete="off"
                   {{#filter.useroverrideactive}}checked{{/filter.useroverrideactive}}>
            <label class="btn btn-outline-secondary livequizmonitor-filter-option"
                   for="livequizmonitor-filter-overrides-useroverride-{{uniqid}}">
                <span data-option-label>{{filter.useroverridelabel}}</span>
                <span class="badge livequizmonitor-count-badge{{^filter.useroverridecount}} livequizmonitor-count-badge-zero{{/filter.useroverridecount}}"
                      data-filter-count="useroverride">{{filter.useroverridecount}}</span>
            </label>
            <input type="radio"
                   class="btn-check"
                   name="livequizmonitor-filter-overrides-{{uniqid}}"
                   id="livequizmonitor-filter-overrides-groupoverride-{{uniqid}}"
                   value="groupoverride"
                   data-filter-option="overrides"
                   autocomplete="off"
                   {{#filter.groupoverrideactive}}checked{{/filter.groupoverrideactive}}>
            <label class="btn btn-outline-secondary livequizmonitor-filter-option"
                   for="livequizmonitor-filter-overrides-groupoverride-{{uniqid}}">
                <span data-option-label>{{filter.groupoverridelabel}}</span>
                <span class="badge livequizmonitor-count-badge{{^filter.groupoverridecount}} livequizmonitor-count-badge-zero{{/filter.groupoverridecount}}"
                      data-filter-count="groupoverride">{{filter.groupoverridecount}}</span>
            </label>
            <input type="radio"
                   class="btn-check"
                   name="livequizmonitor-filter-overrides-{{uniqid}}"
                   id="livequizmonitor-filter-overrides-nooverride-{{uniqid}}"
                   value="nooverride"
                   data-filter-option="overrides"
                   autocomplete="off"
                   {{#filter.nooverrideactive}}checked{{/filter.nooverrideactive}}>
            <label class="btn btn-outline-secondary livequizmonitor-filter-option"
                   for="livequizmonitor-filter-overrides-nooverride-{{uniqid}}">
                <span data-option-label>{{filter.nooverridelabel}}</span>
                <span class="badge livequizmonitor-count-badge{{^filter.nooverridecount}} livequizmonitor-count-badge-zero{{/filter.nooverridecount}}"
                      data-filter-count="nooverride">{{filter.nooverridecount}}</span>
            </label>
            <input type="radio"
                   class="btn-check"
                   name="livequizmonitor-filter-overrides-{{uniqid}}"
                   id="livequizmonitor-filter-overrides-alloverride-{{uniqid}}"
                   value="alloverride"
                   data-filter-option="overrides"
                   autocomplete="off"
                   {{#filter.alloverrideactive}}checked{{/filter.alloverrideactive}}>
            <label class="btn btn-outline-secondary livequizmonitor-filter-option"
                   for="livequizmonitor-filter-overrides-alloverride-{{uniqid}}">
                <span data-option-label>{{filter.alloverridelabel}}</span>
                <span class="badge livequizmonitor-count-badge{{^filter.alloverridecount}} livequizmonitor-count-badge-zero{{/filter.alloverridecount}}"
                      data-filter-count="alloverride">{{filter.alloverridecount}}</span>
            </label>
        </div>
        {{/filter.canviewoverrides}}
    </div>
</div>
<div class="livequizmonitor-filter-reset mb-3">
    <button type="button" class="btn btn-dark btn-sm" data-action="clear-filters">
        {{filter.resetalllabel}}
    </button>
</div>
