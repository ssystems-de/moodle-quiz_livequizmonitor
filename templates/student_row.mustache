{{!
    @template quiz_livequizmonitor/student_row

    Single student row in the live quiz monitor table.

    Example context (json):
    {
        "userid": 42,
        "statusclass": "badge-info",
        "statuslabel": "In progress",
        "fullname": "Jane Student",
        "showemailcolumn": true,
        "email": "jane@example.com",
        "progresspercent": 50,
        "progresstext": "5 / 10",
        "progressbarclass": "bg-info",
        "hastimer": true,
        "timeremaining": 600,
        "timeremainingdisplay": "10:00",
        "showactionscolumn": true,
        "isblocked": false,
        "blockedflaglabel": "Blocked by one-session rule",
        "actionsmenulabel": "Actions",
        "notelabel": "Add note",
        "hasnote": false,
        "hasuseroverride": false,
        "useroverrideflaglabel": "This student has a user override",
        "hasgroupoverride": false,
        "groupoverrideflaglabel": "This student has a group override",
        "hasusertimeoverride": false,
        "hasgrouptimeoverride": false,
        "hastimeoverride": false,
        "timeoverrideflaglabel": "This student has a time-related user override",
        "canextend": true,
        "extendrowlabel": "Extend time",
        "extendactionenabled": true,
        "showattemptslabel": "Show attempts",
        "showlogslabel": "Show logs",
        "attemptendat": 1700000000,
        "onesessionactive": false,
        "_mustache_lint_wrapper": true
    }
}}
{{#_mustache_lint_wrapper}}
<table class="visually-hidden" aria-hidden="true"><tbody>
{{/_mustache_lint_wrapper}}
<tr data-userid="{{userid}}">
    <td data-column="status">
        <span class="badge {{statusclass}}">{{statuslabel}}</span>
    </td>
    <td data-column="student" data-field="fullname">
        <span data-colcontent="student">{{fullname}}</span>
        {{#hasuseroverride}}
        <i class="fa-solid fa-user-gear livequizmonitor-override-flag" data-override-badge="user"
           title="{{useroverrideflaglabel}}"
           aria-label="{{useroverrideflaglabel}}"></i>
        {{/hasuseroverride}}
        {{#hasgroupoverride}}
        <i class="fa-solid fa-users-gear livequizmonitor-override-flag" data-override-badge="group"
           title="{{groupoverrideflaglabel}}"
           aria-label="{{groupoverrideflaglabel}}"></i>
        {{/hasgroupoverride}}
    </td>
    {{#showemailcolumn}}
    <td data-column="email"><span data-colcontent="email">{{email}}</span></td>
    {{/showemailcolumn}}
    <td data-column="progress" data-field="progress">
        <div data-colcontent="progress">
            <div class="livequizmonitor-progress">
                <div class="progress" role="progressbar"
                     aria-valuenow="{{progresspercent}}" aria-valuemin="0" aria-valuemax="100"
                     aria-label="{{progresstext}}">
                    <div class="progress-bar {{progressbarclass}}" style="width: {{progresspercent}}%"></div>
                </div>
                {{#progresstext}}
                <small class="livequizmonitor-progress-label text-muted">{{progresstext}}</small>
                {{/progresstext}}
            </div>
        </div>
    </td>
    <td data-column="timeremaining" data-field="timeremaining">
        {{#hastimer}}
        <span class="livequizmonitor-timer" data-field="timer" data-colcontent="timeremaining"
              data-timeremaining="{{timeremaining}}">{{timeremainingdisplay}}</span>
        {{/hastimer}}
        {{^hastimer}}
        <span class="livequizmonitor-timer" data-field="timer" data-colcontent="timeremaining">—</span>
        {{/hastimer}}
        {{#hastimeoverride}}
        <i class="fa-solid fa-clock livequizmonitor-override-flag livequizmonitor-override-flag-timer"
           title="{{timeoverrideflaglabel}}"
           aria-label="{{timeoverrideflaglabel}}"></i>
        {{/hastimeoverride}}
    </td>
    {{#showactionscolumn}}
    <td class="livequizmonitor-actions" data-column="actions" data-field="actions">
        <div class="livequizmonitor-actions-inner">
            {{> quiz_livequizmonitor/row_action_menu }}
            {{#isblocked}}
            <i class="fa-solid fa-flag livequizmonitor-blocked-flag"
               title="{{blockedflaglabel}}"
               aria-hidden="true"></i>
            {{/isblocked}}
        </div>
    </td>
    {{/showactionscolumn}}
</tr>
{{#_mustache_lint_wrapper}}
</tbody></table>
{{/_mustache_lint_wrapper}}
