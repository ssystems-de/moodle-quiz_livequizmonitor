{{!
    @template quiz_livequizmonitor/student_table

    Student table for the live quiz monitor.

    Example context (json):
    {
        "filterempty": "No students match the current filters.",
        "showemailcolumn": true,
        "showactionscolumn": true,
        "columns": [
            {"id": "status", "label": "Status", "locked": true, "showcolumn": true, "sortable": true,
             "sortcolumn": "status", "active": true, "sorticon": "fa-arrow-up-short-wide",
             "sortlabel": "Ascending", "sortclass": "text-primary", "sortbylabel": "Sort by Status"},
            {"id": "student", "label": "Student", "locked": false, "showcolumn": true, "sortable": true,
             "sortcolumn": "fullname", "active": false, "sorticon": "fa-arrow-up-short-wide",
             "sortlabel": "Sort by Student", "sortclass": "text-secondary", "sortbylabel": "Sort by Student",
             "hidelabel": "Hide Student column", "showlabel": "Show Student column"},
            {"id": "email", "label": "Email", "locked": false, "showcolumn": true, "sortable": true,
             "sortcolumn": "email", "active": false, "sorticon": "fa-arrow-up-short-wide",
             "sortlabel": "Sort by Email", "sortclass": "text-secondary", "sortbylabel": "Sort by Email",
             "hidelabel": "Hide Email column", "showlabel": "Show Email column"},
            {"id": "progress", "label": "Progress", "locked": false, "showcolumn": true, "sortable": true,
             "sortcolumn": "progress", "active": false, "sorticon": "fa-arrow-up-short-wide",
             "sortlabel": "Sort by Progress", "sortclass": "text-secondary", "sortbylabel": "Sort by Progress",
             "hidelabel": "Hide Progress column", "showlabel": "Show Progress column"},
            {"id": "timeremaining", "label": "Time remaining", "locked": false, "showcolumn": true, "sortable": true,
             "sortcolumn": "timeremaining", "active": false, "sorticon": "fa-arrow-up-short-wide",
             "sortlabel": "Sort by Time remaining", "sortclass": "text-secondary",
             "sortbylabel": "Sort by Time remaining",
             "hidelabel": "Hide Time remaining column", "showlabel": "Show Time remaining column"},
            {"id": "actions", "label": "Actions", "locked": true, "showcolumn": true, "sortable": false}
        ],
        "students": []
    }
}}
<div class="alert alert-secondary d-none mb-3" data-region="filter-empty" role="status">
    {{filterempty}}
</div>
<div class="table-responsive livequizmonitor-student-list" data-region="student-table">
    <table class="table table-striped generaltable livequizmonitor-table">
        <thead>
            <tr>
                {{#columns}}
                {{#showcolumn}}
                <th data-column="{{id}}"
                    class="livequizmonitor-th {{^locked}}livequizmonitor-th-toggleable{{/locked}}"
                    {{#sortable}}data-sort-column="{{sortcolumn}}"{{/sortable}}>
                    <span class="livequizmonitor-th-label"
                          data-colcontent="{{id}}"
                          {{#sortable}}data-action="sort-column" data-sort-column="{{sortcolumn}}" role="button" tabindex="0"{{/sortable}}>
                        {{label}}
                        {{#sortable}}
                        {{> quiz_livequizmonitor/sort_icon}}
                        {{/sortable}}
                    </span>
                    {{^locked}}
                    <button type="button"
                            class="livequizmonitor-col-toggle"
                            data-action="toggle-column"
                            data-column="{{id}}"
                            {{#defaulthidden}}data-defaulthidden="1"{{/defaulthidden}}
                            data-hidelabel="{{hidelabel}}"
                            data-showlabel="{{showlabel}}"
                            aria-pressed="true"
                            aria-expanded="true"
                            title="{{hidelabel}}">
                        <i class="fa-solid fa-minus" aria-hidden="true"></i>
                        <span class="sr-only">{{hidelabel}}</span>
                    </button>
                    {{/locked}}
                </th>
                {{/showcolumn}}
                {{/columns}}
            </tr>
        </thead>
        <tbody>
            {{#students}}
            {{> quiz_livequizmonitor/student_row }}
            {{/students}}
        </tbody>
    </table>
</div>
